# The Verilator this simulation needs. The one place for the pin: sim/vl/build.sh, sim/vl/install_verilator.sh,
# sim/container/install.sh and .github/workflows/run_simulation_verilator.yaml read it (shell syntax, sourced).
# The workflow builds the pin through sim/container/install.sh and keys its cache on this file.
#
#   VERILATOR_REF  what install_verilator.sh builds: a release tag (v5.052) or a commit
#   VERILATOR_MIN  the oldest build that build.sh accepts, as `verilator --version` prints it after `rev`:
#                  a tag (v5.052), or <tag>-<commits after it> for a master build (v5.052-N)
#   verilator_rev  prints that `rev` value of the verilator in PATH (or of the binary given as $1):
#                  `v5.052` for a release, `v5.052-N-g<hash>` for a master build N commits after it
#
# Why a commit: release 5.052 does not elaborate constant functions that return unpacked arrays
# (libstf global_config.sv). It also loses a clocking drive after a mailbox wake (verilator/verilator#8771)
# and master between #8772 and #8859 raises BLKANDNBLK on clocking block outputs that the design drives
# with <=. The pinned master commit has the fixes of #8772, #8777 and #8859 and elaborates libstf.
# With the first release that contains it, set both lines to its tag.
VERILATOR_REF=966105b21
VERILATOR_MIN=v5.052-538
verilator_rev() {
    "${1:-verilator}" --version 2>/dev/null | awk '{for (i = 1; i < NF; i++) if ($i == "rev") print $(i + 1)}'
}
